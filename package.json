{
  "name": "multilocale",
  "version": "1.0.0",
  "description": "multilocale cli to download translation files from multilocale.com",
  "type": "commonjs",
  "private": false,
  "scripts": {
    "develop": "node index.js",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm run build",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "multi-language",
    "multilingual",
    "translate",
    "localize",
    "internationalize",
    "translation",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multilocale/multilocale-cli.git"
  },
  "author": "Multilocale",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/multilocale/multilocale-cli/issues"
  },
  "homepage": "https://www.multilocale.com/",
  "bin": {
    "multilocale": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "fs-extra": "10.1.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1",
    "xml2js": "0.4.23"
  },
  "devDependencies": {
    "@multilocale/multilocale-js-client": "0.0.11",
    "esbuild": "^0.25.4"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
